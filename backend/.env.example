# ==============================================================================
# WorkforceHub Backend Environment Configuration Template
# Phase 8B: Production-Quality Authentication & Security
# 
# Instructions:
# Copy this file to '.env' or configure these environment variables in your
# system or deployment runtime. Never commit production passwords or secrets.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080
SESSION_COOKIE_SECURE=false

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=workforcehub_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Frontend CORS Origin (Vite default dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JPA / Hibernate & Flyway Settings
JPA_SHOW_SQL=false
FLYWAY_ENABLED=true

# Initial Account Bootstrapping (One-time setup if accounts do not exist)
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_EMAIL=admin@workforcehub.io
ADMIN_BOOTSTRAP_PASSWORD=AdminSecure2026!
EMPLOYEE_BOOTSTRAP_EMAIL=employee@workforcehub.io
EMPLOYEE_BOOTSTRAP_PASSWORD=EmployeeSecure2026!
